{
    "name": "cosnics/cosnics",
    "description": "Cosnics",
    "license": "MIT",
    "keywords": [
        "ELO",
        "LCMS",
        "Cosnics"
    ],
    "support": {
        "source": "https://github.com/cosnics/cosnics",
        "issues": "https://github.com/cosnics/cosnics/issues"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-exif": "*",
        "ext-ftp": "*",
        "ext-soap": "*",
        "ext-zip": "*",
        "apereo/phpcas": "1.6.*",
        "chamilo/pear-libraries": "dev-symfony",
        "composer/composer": "2.9.*",
        "doctrine/collections": "2.*",
        "doctrine/dbal": "4.*",
        "econea/nusoap": "0.9.*",
        "ezyang/htmlpurifier": "4.*",
        "google/apiclient": "1.*",
        "hackzilla/password-generator": "1.*",
        "league/flysystem": "3.*",
        "league/flysystem-ftp": "3.*",
        "league/oauth2-client": "2.*",
        "microsoft/microsoft-graph": "2.*",
        "mobiledetect/mobiledetectlib": "4.8.*",
        "monolog/monolog": "3.*",
        "phpmailer/phpmailer": "7.*",
        "phpoffice/phpspreadsheet": "5.*",
        "sabre/vobject": "4.*",
        "sentry/sdk": "4.*",
        "symfony/cache": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bridge": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "3.21.*",
        "voku/stringy": "6.*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/cosnics/pear-libraries"
        }
    ],
    "autoload": {
        "psr-4": {
            "Chamilo\\": "src/Chamilo/"
        },
        "classmap": [
            "src/Chamilo/Libraries/UserInterface/Form/Architecture/Domain/Element/"
        ],
        "exclude-from-classmap": [
            "src/Chamilo/Libraries/UserInterface/Form/Architecture/Domain/Element/AdvancedElementFinder/"
        ]
    },
    "config": {
        "bin-dir": "bin/",
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "scripts": {
        "pre-install-cmd": "Chamilo\\Libraries\\Filesystem\\Service\\BuildUtilities::processComposer",
        "pre-update-cmd": "Chamilo\\Libraries\\Filesystem\\Service\\BuildUtilities::processComposer"
    }
}
