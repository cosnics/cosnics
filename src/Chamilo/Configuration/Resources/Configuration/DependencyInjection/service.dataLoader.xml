<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true"
                  autoconfigure="true"
                  public="true"/>

        <service id="Chamilo\Configuration\Service\DataLoader\FileConfigurationCacheDataPreLoader">
            <tag name="Chamilo\Libraries\Cache\CacheDataPreLoaderService"/>
            <argument key="$cacheAdapter"
                      type="service"
                      id="Chamilo\Configuration\Service\DataLoader\FileConfigurationCacheAdapter"/>
        </service>

        <service id="Chamilo\Configuration\Service\DataLoader\FileConfigurationCacheAdapter"
                 class="Symfony\Component\Cache\Adapter\ArrayAdapter">
            <tag name="Symfony\Component\Cache\Adapter"/>
        </service>

        <service id="Chamilo\Configuration\Service\DataLoader\LanguageCacheDataPreLoader">
            <tag name="Chamilo\Libraries\Cache\CacheDataPreLoaderService"/>
            <argument key="$cacheAdapter"
                      type="service"
                      id="Chamilo\Configuration\Service\DataLoader\LanguageCacheAdapter"/>
        </service>

        <service id="Chamilo\Configuration\Service\DataLoader\LanguageCacheAdapter"
                 class="Symfony\Component\Cache\Adapter\PhpFilesAdapter">
            <tag name="Symfony\Component\Cache\Adapter"/>
            <factory service="Chamilo\Libraries\Cache\SymfonyCacheAdapterFactory"
                     method="createPhpFilesAdapter"/>
            <argument key="$namespace">Chamilo\Configuration\Service\Language</argument>
        </service>

        <service id="Chamilo\Configuration\Service\DataLoader\RegistrationCacheDataPreLoader">
            <tag name="Chamilo\Libraries\Cache\CacheDataPreLoaderService"/>
            <argument key="$cacheAdapter"
                      type="service"
                      id="Chamilo\Configuration\Service\DataLoader\RegistrationCacheAdapter"/>
        </service>

        <service id="Chamilo\Configuration\Service\DataLoader\RegistrationCacheAdapter"
                 class="Symfony\Component\Cache\Adapter\PhpFilesAdapter">
            <tag name="Symfony\Component\Cache\Adapter"/>
            <factory service="Chamilo\Libraries\Cache\SymfonyCacheAdapterFactory"
                     method="createPhpFilesAdapter"/>
            <argument key="$namespace">Chamilo\Configuration\Service\Registration</argument>
        </service>

        <service id="Chamilo\Configuration\Service\DataLoader\StorageConfigurationCacheDataPreLoader">
            <tag name="Chamilo\Libraries\Cache\CacheDataPreLoaderService"/>
            <argument key="$cacheAdapter"
                      type="service"
                      id="Chamilo\Configuration\Service\DataLoader\StorageConfigurationCacheAdapter"/>
        </service>

        <service id="Chamilo\Configuration\Service\DataLoader\StorageConfigurationCacheAdapter"
                 class="Symfony\Component\Cache\Adapter\PhpFilesAdapter">
            <tag name="Symfony\Component\Cache\Adapter"/>
            <factory service="Chamilo\Libraries\Cache\SymfonyCacheAdapterFactory"
                     method="createPhpFilesAdapter"/>
            <argument key="$namespace">Chamilo\Configuration\Service\Configuration\Storage</argument>
        </service>
    </services>
</container>