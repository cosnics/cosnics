<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true"
                  autoconfigure="true"
                  public="true"/>

        <service id="Chamilo\Core\Group\UserInterface\Menu\GroupTreeMenuDataProvider"/>
        <service id="Chamilo\Core\Group\UserInterface\Menu\GroupOptionsTreeDataProvider"/>

        <service id="Chamilo\Core\Group\UserInterface\Menu\GroupJsTreeMenuDataProvider"
                 class="Chamilo\Libraries\Format\Menu\TreeMenu\JsTreeMenuDataProvider">
            <argument key="$treeMenuDataProvider"
                      type="service"
                      id="Chamilo\Core\Group\UserInterface\Menu\GroupTreeMenuDataProvider"/>
        </service>

        <service id="Chamilo\Core\Group\UserInterface\Menu\GroupOptionsTreeRenderer"
                 class="Chamilo\Libraries\Format\Menu\TreeMenu\OptionsTreeRenderer">
            <argument key="$optionsTreeDataProvider"
                      type="service"
                      id="Chamilo\Core\Group\UserInterface\Menu\GroupOptionsTreeDataProvider"/>
        </service>
    </services>
</container>