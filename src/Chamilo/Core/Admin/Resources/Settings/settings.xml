<?xml version="1.0" encoding="UTF-8"?>
<package context="Chamilo\Core\Admin">
    <settings>
        <category name="administrator">
            <setting name="administrator_name"
                     field="text"
                     default="Chamilo"/>
            <setting name="administrator_email"
                     field="text"
                     default="chamilo.admin@mychamilo.com">
                <validations>
                    <validation rule="email"
                                message="MustBeAnEMailAddress"/>
                </validations>
            </setting>
            <setting name="administrator_website"
                     field="text"/>
        </category>
        <category name="whoisonline">
            <setting name="timelimit"
                     field="text"
                     default="30">
                <validations>
                    <validation rule="numeric"
                                message="MustBeNumeric"/>
                </validations>
            </setting>
        </category>
        <category name="platform">
            <setting name="site_name"
                     field="text"
                     default="Chamilo"/>
            <setting name="institution"
                     field="text"
                     default="Chamilo"/>
            <setting name="institution_url"
                     field="text"
                     default="http://www.chamilo.org">
                <validations>
                    <validation rule="regex"
                                format="/http:\/\/.*/"
                                message="MustStartWithHTTP"/>
                </validations>
            </setting>
            <setting name="no_reply_email"
                     field="text"
                     default="">
                <validations>
                    <validation rule="email"
                                message="MustBeAnEMailAddress"/>
                </validations>
            </setting>
            <setting name="mailer"
                     field="select"
                     default="Chamilo\Libraries\Mail\Mailer\PhpMailer\Mailer"
                     user_setting="0">
                <options type="dynamic"
                         source="getMailers"/>
            </setting>
            <setting name="google_analytics_tracking_id"
                     field="text"
                     default=""/>
        </category>
        <category name="maintenance">
            <setting name="maintenance_warning_show"
                     field="toggle"
                     default="0">
                <options type="static">
                    <option name="maintenance_warning_show"
                            value="1"/>
                </options>
            </setting>
            <setting name="maintenance_warning_message"
                     field="text"
                     default=""/>
            <setting name="maintenance_block_access"
                     field="toggle"
                     default="0">
                <options type="static">
                    <option name="maintenance_block_access"
                            value="1"/>
                </options>
            </setting>
        </category>
        <category name="visual">
            <setting name="platform_language"
                     field="select"
                     default="english"
                     user_setting="1">
                <options type="dynamic"
                         source="getLanguages"/>
                <availability source="isAllowedToChangePlatformLanguage"/>
            </setting>
            <setting name="platform_timezone"
                     field="select"
                     default="Europe/Brussels"
                     user_setting="1">
                <options type="dynamic"
                         source="getTimeZones"/>
                <availability source="isAllowedToChangePlatformTimezone"/>
            </setting>
            <setting name="theme"
                     field="select"
                     default="Aqua"
                     user_setting="1">
                <options type="dynamic"
                         source="getThemes"/>
                <availability source="isAllowedToChangeTheme"/>
            </setting>
            <setting name="portal_home"
                     field="html_editor"
                     default=""/>
        </category>

        <category name="caching">
            <setting name="refresh_external"
                     field="text"
                     default="60"
                     user_setting="1"/>
        </category>
    </settings>
</package>
