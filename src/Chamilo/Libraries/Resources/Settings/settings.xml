<?xml version="1.0" encoding="UTF-8"?>
<package context="Chamilo\Libraries">
    <settings>
        <category name="authentication">
            <setting name="enableExternalAuthentication"
                     field="HTML_QuickForm_HTML_QuickForm_toggle">
                <options type="static">
                    <option name="enableExternalAuthentication"
                            value="1"/>
                </options>
            </setting>
            <setting name="enableChamiloLibrariesAuthenticationPlatform"
                     field="HTML_QuickForm_toggle"
                     default="1">
                <options type="static">
                    <option name="enablePlatformAuthenticationPlatform"
                            value="1"/>
                </options>
            </setting>
            <setting name="enableChamiloLibrariesAuthenticationSecurityToken"
                     field="HTML_QuickForm_toggle">
                <options type="static">
                    <option name="enableChamiloLibrariesAuthenticationSecurityToken"
                            value="1"/>
                </options>
            </setting>
            <setting name="enableChamiloLibrariesAuthenticationAnonymous"
                     field="HTML_QuickForm_toggle">
                <options type="static">
                    <option name="enableChamiloLibrariesAuthenticationAnonymous"
                            value="0"/>
                </options>
            </setting>
            <setting name="enableChamiloLibrariesAuthenticationCas"
                     field="HTML_QuickForm_toggle">
                <options type="static">
                    <option name="enableChamiloLibrariesAuthenticationCas"
                            value="1"/>
                </options>
            </setting>
        </category>
        <category name="cas_authentication">
            <setting name="cas_host"
                     field="HTML_QuickForm_text"
                     default=""/>
            <setting name="cas_port"
                     field="HTML_QuickForm_text"
                     default=""/>
            <setting name="cas_uri"
                     field="HTML_QuickForm_text"
                     default=""/>
            <setting name="cas_version"
                     field="Chamilo\Libraries\Format\Form\Element\HTML_QuickForm_bootstrap_radio"
                     default="SAML_VERSION_1_1">
                <options type="static">
                    <option name="SAML VERSION 1.1"
                            value="SAML_VERSION_1_1"/>
                    <option name="CAS VERSION 2.0"
                            value="CAS_VERSION_2_0"/>
                </options>
            </setting>
            <setting name="cas_check_certificate"
                     field="HTML_QuickForm_toggle"
                     default="1">
                <options type="static">
                    <option name="cas_check_certificate"
                            value="1"/>
                </options>
            </setting>
            <setting name="cas_certificate"
                     field="HTML_QuickForm_text"
                     default=""/>
            <setting name="cas_enable_log"
                     field="HTML_QuickForm_toggle">
                <options type="static">
                    <option name="cas_enable_log"
                            value="1"/>
                </options>
            </setting>
            <setting name="cas_log"
                     field="HTML_QuickForm_text"
                     default=""/>
        </category>
