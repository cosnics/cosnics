            </setting>
            <setting name="cosnics.libraries.calendar.hideNonWorkingHours"
                     field="HTML_QuickForm_checkbox"
                     default="0">
                <options type="static">
                    <option name="hide_non_working_hours"
                            value="1"/>
                </options>
            </setting>
            <setting name="cosnics.libraries.calendar.defaultView"
                     field="Chamilo\Libraries\Format\Form\Element\HTML_QuickForm_bootstrap_radio"
                     default="Month">
                <options type="static">
                    <option name="Month"
                            value="Month"/>
                    <option name="Week"
                            value="Week"/>
                    <option name="Day"
                            value="Day"/>
                    <option name="List"
                            value="List"/>
                </options>
            </setting>
            <setting name="cosnics.libraries.calendar.firstDayOfWeek"
                     field="Chamilo\Libraries\Format\Form\Element\HTML_QuickForm_bootstrap_radio"
                     default="monday">
                <options type="static">
                    <option name="Sunday"
                            value="sunday"/>
                    <option name="Monday"
                            value="monday"/>
                </options>
            </setting>
        </category>
        <category name="MicrosoftGraph">
            <setting name="cosnics.libraries.protocol.microsoft.graph.externalUserIdentifier"
                     field="HTML_QuickForm_text"
                     default=""/>
        </category>
        <category name="UserInterface">
            <setting name="cosnics.libraries.userInterface.translation.language.default"
                     field="HTML_QuickForm_select"
                     default="english">
                <options type="dynamic"
                         source="getLanguages"/>
                <availability source="isAllowedToChangePlatformLanguage"/>
            </setting>
            <setting name="cosnics.libraries.calendar.timezone"
                     field="HTML_QuickForm_select"
                     default="Europe/Brussels">
                <options type="dynamic"
                         source="getTimeZones"/>
                <availability source="isAllowedToChangePlatformTimezone"/>
            </setting>
        </category>
        <category name="Caching">
            <setting name="cosnics.libraries.storage.cache.external.defaultLifetime"
                     field="HTML_QuickForm_text"
                     default="3600"/>
        </category>
    </settings>
</package>
