{# form.bootstrap.html.twig #}
{% extends 'bootstrap_5_layout.html.twig' %}
{%- block choice_widget_options -%}
    {% for group_label, choice in options %}
        {%- if choice is iterable -%}
            <optgroup label="{{ choice_translation_domain is same as(false) ? group_label : group_label|trans({}, choice_translation_domain) }}">
                {% set options = choice %}
                {{- block('choice_widget_options') -}}
            </optgroup>
        {%- else -%}
            <option value="{{ choice.value }}"{% if choice.attr %}{% with {attr: choice.attr} %}{{ block('attributes') }}{% endwith %}{% endif %}{% if (not render_preferred_choices|default(false) or not (duplicate_preferred_choices ?? true)) and choice is selectedchoice(value) %} selected="selected"{% endif %}>{{ choice_translation_domain is same as(false) ? choice.label|raw : choice.label|trans(choice.labelTranslationParameters, choice_translation_domain) }}</option>
        {%- endif -%}
    {% endfor %}
{%- endblock choice_widget_options -%}

{%- block html_row -%}
    {{ block('html_widget') }}
{%- endblock html_row -%}

{%- block html_widget -%}
    {{ html|raw }}
{%- endblock html_widget -%}

{%- block visual_content_widget -%}
    <div class="form-control">{{ value|raw }}</div>
{%- endblock visual_content_widget -%}

{%- block message_row -%}
    <div role="alert" class="callout callout-{{ form.vars.messageType }}">
        {%- if label is defined -%}
            <h4 class="callout-heading">{{ label|raw }}</h4>
        {%- endif -%}

        {{ block('message_widget') }}
    </div>
{%- endblock message_row -%}

{%- block message_widget -%}
    <p>{{ message|raw }}</p>
{%- endblock message_widget -%}

{%- block category_row -%}
    <h4 class="form-category">{{ label|raw }}</h4>
{%- endblock category_row -%}

{%- block html_editor_row -%}
    {%- set row_class = row_class|default(row_attr.class|default('mb-3')|trim) -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {%- if 'form-floating' in row_class -%}
            {{ block('textarea_widget') }}
            {{ block('html_editor_widget') }}
            {{- form_label(form) -}}
        {%- else -%}
            {{- form_label(form) -}}
            {{ block('textarea_widget') }}
            {{ block('html_editor_widget') }}
        {%- endif -%}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock html_editor_row -%}

{%- block html_editor_widget -%}
    {{ javascriptSourceCode|raw }}
    <script>
        tinymce.init({
            selector: 'textarea#{{ id }}',
            license_key: 'gpl',
            height: {{ height }},
            max_height: {{ max_height }},
            plugins: {{ plugins|json_encode|raw }},
            toolbar: '{{ toolbar }}',
            statusbar: {{ statusbar ? 'true' : 'false' }},
            language: '{{ language }}',
            language_url: '{{ languagePath }}'
        });

        document.querySelector('form').addEventListener('submit', function (e) {
            //e.preventDefault();

            var tinyInstance = tinymce.get('{{ id }}');
            tinyInstance.save();
            const content = tinyInstance.getContent();

            // if (!content || content.trim() === '') {
            //     alert('Please fill in the required field');
            //     tinyInstance.focus();
            //     return false;
            // }

            return true;
        });
    </script>
{%- endblock html_editor_widget -%}

{% block element_finder_widget %}
    {% apply spaceless %}
        <button id="{{ id }}_expand_button" class="normal select" {% if not collapsed %}style="display:none;"{% endif %}>{{ translations.show }}</button>
        <div class="element_finder" id="{{ id }}" style="margin-top: 5px;">
            <input type="hidden" name="{{ full_name }}" id="hidden_active_elements"/>
            <div class="element_finder_types">
                <select name="" id="element_types_selector">
                    <option value="-1">-- {{ translations.selectElementType }} --</option>
                    {% for option_value, option_label in elementTypesSelector %}
                        <option value="{{ option_value }}">{{ option_label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="element_finder_container">
                <div class="element_finder_search">
                    <input type="text" class="element_query" id="search_field" name=""/>
                    <button id="{{ id }}_collapse_button" class="normal hide mini" {% if collapsed %}style="display:none;"{% endif %}>{{ translations.hide }}</button>
                </div>
                <div class="clear"></div>
                <div class="element_finder_elements">
                    <div class="element_finder_inactive">
                        <div id="inactive_elements" class="inactive_elements" style="height: {{ height }}px; width: {{ width }}px; overflow: auto;"></div>
                        <div class="clear"></div>
                    </div>
                    <div class="element_finder_buttons" style="height: {{ height }}px;">
                        <div class="element_finder_buttons_container">
                            <input type="button" id="activate_button" class="activate_elements" name="{{ id }}_activate">
                            <br/>
                            <input type="button" id="deactivate_button" class="deactivate_elements" name="{{ id }}_deactivate">
                        </div>
                    </div>
                    <div class="element_finder_active">
                        <div id="active_elements" class="active_elements" style="height: {{ height }}px; width: {{ width }}px; overflow: auto;"></div>
                        <div class="clear"></div>
                    </div>
                    <div class="clear"></div>
                </div>
                <div class="clear"></div>
            </div>
        </div>

        {{ element_finder_plugin|raw }}

        {% set defaultValuesString = '' %}
        {% if value %}
            {% set defaultValuesString = 'defaultValues: ' ~ value %}
        {% endif %}

        <script type="text/javascript">
            $("#{{ id }}").advelementfinder({
                name: "{{ id }}",
                elementTypes: {{ elementTypes|raw }}, {{ defaultValuesString|raw }}{{ configurationJson|raw }} });
        </script>
    {% endapply %}
{% endblock %}