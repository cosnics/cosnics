{# form.html.twig #}
{% form_theme form 'form.bootstrap.html.twig' %}

{{ form_start(form) }}
{% for field in form %}
    {% if field.vars.name != 'buttons' %}
        {{ form_row(field) }}
    {% endif %}
{% endfor %}

{% if form.buttons is defined %}
    <div class="mb-3">
        {% for button in form.buttons %}
            {{ form_widget(button) }}
        {% endfor %}
    </div>
{% endif %}

{{ form_end(form) }}